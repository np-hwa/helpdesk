    PRIORITY_MATRIX {
        varchar impact
        varchar urgency
        tinyint score
        varchar priority
    }
    SLA_CONFIG {
        varchar priority PK
        int response_minutes
        int resolution_minutes
        boolean is_24x7
    }
    BUSINESS_HOURS_CONFIG {
        tinyint day_of_week
        date holiday_date
        time start_time
        time end_time
    }
    TICKETS {
        bigint id PK
        varchar status
        varchar priority
        boolean is_resolution_confirmed
        boolean is_auto_closed
        int reopen_count
        datetime sla_deadline
    }
